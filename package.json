{
  "name": "copilot-usage-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "test:copilot-sdk": "tsx scripts/copilot-sdk-test.ts",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@github/copilot-sdk": "^1.0.22",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
