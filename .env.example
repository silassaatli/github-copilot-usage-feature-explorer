# Bu dosyayı .env olarak kopyalayın. .env Git tarafından yok sayılır; gerçek anahtarı
# yalnızca .env içine yazın, bu örnek dosyaya veya kaynak koda yazmayın.

# Claude için Anthropic Console API anahtarı (Console > API Keys). Boş bırakılırsa
# Claude devre dışı kalır; uygulamanın geri kalanı çalışmaya devam eder.
ANTHROPIC_API_KEY=

# --- İsteğe bağlı ayarlar (README > Yapılandırma) ---
# Claude modeli: takma ad (haiku, sonnet, opus, fable) veya tam model kimliği.
# CLAUDE_AGENT_MODEL=haiku
# CLAUDE_AGENT_EFFORT=low
# CLAUDE_REQUEST_TIMEOUT_MS=120000
# COPILOT_REQUEST_TIMEOUT_MS=120000
# PORT=3001
# DATABASE_PATH=data/explorer.sqlite
# HISTORY_RETENTION=1000
